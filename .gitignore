# Dependencies and build output
node_modules/
.expo/
dist/
web-build/
coverage/
*.tsbuildinfo

# Native folders are generated by `expo prebuild` (Continuous Native Generation)
/ios/
/android/

# Environment and secrets (commit only .env.example, names without values)
.env
.env*
!.env.example
*.pem
*.p8
*.p12
*.key
*.jks
*.keystore
google-services.json
GoogleService-Info.plist
service-account*.json

# Firebase emulator and CLI output
.firebase/
emulator-data/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*

# Third-party design references (not ours to publish)
docs/references/

# Image work files (site-media): only compressed WebP in assets is committed
docs/image-requests/returned/

# QA artefacts (screenshots are regenerated; commit only reports)
docs/qa/**/shots/
docs/qa/**/sheets/

# Local agent configuration
.claude/
CLAUDE.md

# OS and editor
.DS_Store
Thumbs.db
*.log
.vscode/*
!.vscode/extensions.json
.idea/

# Expo / Metro (from the SDK 58 template)
expo-env.d.ts
.kotlin/
*.orig.*
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
