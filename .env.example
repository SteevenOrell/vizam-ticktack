# Copy to .env (git-ignored) and fill in. Names only here; never commit values.
# Firebase web app config (public identifiers; access is protected by firestore.rules).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Local development against the Firebase Emulator Suite (true / false) and its host (no scheme, no port).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
