rules_version = '2';

// TickTack Firestore rules (docs/ARCHITECTURE.md section 7).
// - Every document lives under users/{uid} and only that signed-in user can read or write it.
// - Writes are full documents with an exact key set per collection, typed and size-checked fields, the path ID in
//   `id`, the caller's uid in `ownerId` and `updatedAt == request.time` (server timestamp; last write wins).
// - Tombstones are sticky: a deleted document can never be turned back into a live one.
// - Default deny for everything else. Covered by tests/rules/*.test.ts in the emulator.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function str(v, lo, hi) {
      return v is string && v.size() >= lo && v.size() <= hi;
    }
    function optStr(v, lo, hi) {
      return v == null || str(v, lo, hi);
    }
    function intIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }
    function optInt(v, lo, hi) {
      return v == null || intIn(v, lo, hi);
    }
    function isId(v) {
      return v is string && v.matches('^[A-Za-z0-9_-]{1,128}$');
    }
    function optId(v) {
      return v == null || isId(v);
    }
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function optDate(v) {
      return v == null || isDate(v);
    }
    function optTime(v) {
      return v == null || (v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }
    function optIso(v) {
      return v == null || str(v, 10, 40);
    }
    function colorOk(v) {
      return v in ['ember', 'sage', 'sky', 'plum', 'moss', 'sand', 'rose', 'slate'];
    }
    function exactKeys(d, fields) {
      let keys = fields.concat(['id', 'ownerId', 'createdAt', 'clientUpdatedAt', 'updatedAt', 'deleted', 'schemaVersion']);
      return d.keys().hasAll(keys) && d.keys().hasOnly(keys);
    }

    // Shape every write must have, whatever the collection.
    function baseOk(d, uid, id) {
      return d.ownerId == uid
        && d.id == id
        && isId(id)
        && d.updatedAt == request.time
        && d.deleted is bool
        && intIn(d.schemaVersion, 1, 99)
        && str(d.createdAt, 10, 40)
        && str(d.clientUpdatedAt, 10, 40);
    }

    // Updates: identity is immutable (also implied by baseOk) and tombstones stay tombstones.
    function updateOk() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id
        && !(resource.data.deleted == true && request.resource.data.deleted != true);
    }

    // ---------- per-collection shapes ----------
    function profileOk(d) {
      return exactKeys(d, ['displayName', 'timeZone', 'weekStartsOn', 'theme', 'dayStart', 'dayEnd',
          'dailyCapacityMin', 'defaultReminderOffsetMin', 'onboardingCompletedAt'])
        && optStr(d.displayName, 1, 60)
        && str(d.timeZone, 1, 64)
        && d.weekStartsOn in [0, 1, 6]
        && d.theme in ['system', 'dark', 'light']
        && optTime(d.dayStart) && optTime(d.dayEnd)
        && intIn(d.dailyCapacityMin, 0, 1440)
        && intIn(d.defaultReminderOffsetMin, 0, 10080)
        && optIso(d.onboardingCompletedAt);
    }

    function categoryOk(d) {
      return exactKeys(d, ['name', 'color', 'icon', 'sortOrder', 'archived'])
        && str(d.name, 1, 40)
        // Free-text names are stored trimmed (no leading or trailing whitespace).
        && d.name.matches('^\\S(.*\\S)?$')
        && colorOk(d.color)
        && d.icon in ['target', 'heart', 'home', 'book', 'briefcase', 'star', 'leaf', 'dot']
        && intIn(d.sortOrder, 0, 10000)
        && d.archived is bool;
    }

    function taskOk(d) {
      return exactKeys(d, ['title', 'notes', 'status', 'priority', 'categoryId', 'goalId', 'milestoneId',
          'parentTaskId', 'date', 'startTime', 'durationMin', 'sortOrder', 'completedAt', 'recurrenceRuleId'])
        && str(d.title, 1, 200)
        && optStr(d.notes, 0, 5000)
        && d.status in ['open', 'done', 'cancelled']
        && intIn(d.priority, 0, 3)
        && optId(d.categoryId) && optId(d.goalId) && optId(d.milestoneId) && optId(d.parentTaskId)
        && optDate(d.date)
        && optTime(d.startTime)
        && optInt(d.durationMin, 1, 1440)
        && intIn(d.sortOrder, 0, 100000)
        && optIso(d.completedAt)
        && optId(d.recurrenceRuleId);
    }

    function ruleOk(d) {
      return exactKeys(d, ['seriesType', 'seriesId', 'freq', 'interval', 'byWeekday', 'byMonthDay', 'weekStartsOn',
          'startDate', 'endType', 'endDate', 'count'])
        && d.seriesType in ['task', 'routine']
        && isId(d.seriesId)
        && d.freq in ['daily', 'weekly', 'monthly']
        && intIn(d.interval, 1, 99)
        && (d.byWeekday == null || (d.byWeekday is list && d.byWeekday.size() <= 7
            && d.byWeekday.hasOnly([0, 1, 2, 3, 4, 5, 6])))
        && optInt(d.byMonthDay, 1, 31)
        && d.weekStartsOn in [0, 1, 6]
        && isDate(d.startDate)
        && d.endType in ['never', 'onDate', 'afterCount']
        && optDate(d.endDate)
        && optInt(d.count, 1, 999);
    }

    function occurrenceOk(d, id) {
      return exactKeys(d, ['seriesType', 'seriesId', 'ruleId', 'originalDate', 'date', 'startTime', 'durationMin',
          'title', 'notes', 'status', 'completedAt', 'completedStepIds', 'isException'])
        && d.seriesType in ['task', 'routine']
        && isId(d.seriesId) && isId(d.ruleId)
        && isDate(d.originalDate) && isDate(d.date)
        // Deterministic ID: seriesId + "_" + YYYYMMDD of the original date.
        && id == d.seriesId + '_' + d.originalDate.replace('-', '')
        && optTime(d.startTime)
        && optInt(d.durationMin, 1, 1440)
        && optStr(d.title, 1, 200)
        && optStr(d.notes, 0, 5000)
        && d.status in ['scheduled', 'done', 'skipped']
        && optIso(d.completedAt)
        && d.completedStepIds is list && d.completedStepIds.size() <= 60
        && d.isException is bool;
    }

    function reminderOk(d) {
      return exactKeys(d, ['targetType', 'targetId', 'kind', 'offsetMin', 'atTime', 'enabled'])
        && d.targetType in ['task', 'routine', 'goal']
        && isId(d.targetId)
        && d.kind in ['relative', 'absolute']
        && optInt(d.offsetMin, 0, 10080)
        && optTime(d.atTime)
        && d.enabled is bool;
    }

    function goalOk(d) {
      return exactKeys(d, ['title', 'description', 'targetDate', 'status', 'color', 'progressMode', 'manualProgress',
          'achievedAt'])
        && str(d.title, 1, 120)
        && optStr(d.description, 0, 2000)
        && optDate(d.targetDate)
        && d.status in ['active', 'achieved', 'archived']
        && (d.color == null || colorOk(d.color))
        && d.progressMode in ['milestones', 'tasks', 'manual']
        && intIn(d.manualProgress, 0, 100)
        && optIso(d.achievedAt);
    }

    function milestoneOk(d) {
      return exactKeys(d, ['goalId', 'title', 'dueDate', 'completedAt', 'sortOrder'])
        && isId(d.goalId)
        && str(d.title, 1, 120)
        && optDate(d.dueDate)
        && optIso(d.completedAt)
        && intIn(d.sortOrder, 0, 10000);
    }

    function routineOk(d) {
      return exactKeys(d, ['title', 'partOfDay', 'startTime', 'steps', 'categoryId', 'active', 'recurrenceRuleId'])
        && str(d.title, 1, 80)
        && d.partOfDay in ['morning', 'afternoon', 'evening', 'anytime']
        && optTime(d.startTime)
        && d.steps is list && d.steps.size() <= 30
        && optId(d.categoryId)
        && d.active is bool
        && optId(d.recurrenceRuleId);
    }

    function entityOk(collection, d, id) {
      return (collection == 'categories' && categoryOk(d))
        || (collection == 'tasks' && taskOk(d))
        || (collection == 'recurrenceRules' && ruleOk(d))
        || (collection == 'occurrences' && occurrenceOk(d, id))
        || (collection == 'reminders' && reminderOk(d))
        || (collection == 'goals' && goalOk(d))
        || (collection == 'milestones' && milestoneOk(d))
        || (collection == 'routines' && routineOk(d));
    }

    function syncedCollection(name) {
      return name in ['categories', 'tasks', 'recurrenceRules', 'occurrences', 'reminders', 'goals', 'milestones',
        'routines'];
    }

    // ---------- paths ----------
    match /users/{uid} {
      allow get: if signedInAs(uid);
      allow create: if signedInAs(uid) && baseOk(request.resource.data, uid, uid) && profileOk(request.resource.data);
      allow update: if signedInAs(uid) && baseOk(request.resource.data, uid, uid) && profileOk(request.resource.data)
        && updateOk();
      allow delete: if signedInAs(uid);

      match /{collection}/{id} {
        allow get, list: if signedInAs(uid) && syncedCollection(collection);
        allow create: if signedInAs(uid) && syncedCollection(collection)
          && baseOk(request.resource.data, uid, id) && entityOk(collection, request.resource.data, id);
        allow update: if signedInAs(uid) && syncedCollection(collection)
          && baseOk(request.resource.data, uid, id) && entityOk(collection, request.resource.data, id)
          && updateOk();
        allow delete: if signedInAs(uid) && syncedCollection(collection);
      }
    }

    // Default deny: anything not matched above is refused.
  }
}
